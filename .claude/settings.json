{
  "outputStyle": "fluent-korean",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "PowerShell(.\\gradlew.bat:*)",
      "Bash(bash scripts/check-docs.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-tree:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree list)",
      "Bash(git stash list)",
      "Bash(gh auth status)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh api:*)",
      "Bash(gh label list:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/guard-branch.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/session-context.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/stop-docs-check.sh" }
        ]
      }
    ]
  }
}
