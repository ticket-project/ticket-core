                      "query": "sum:container.cpu.usage{$env,$host,container_name:ticket-queue-*} by {container_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "CPU"
                    }
                  ],
                  "display_type": "area"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
