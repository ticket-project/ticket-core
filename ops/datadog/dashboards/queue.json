          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "호스트·컨테이너",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "호스트 CPU % (host별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.cpu.user{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:system.cpu.system{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "avg:system.cpu.iowait{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "d",
                      "query": "avg:system.cpu.stolen{$env,$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "user"
                    },
                    {
                      "formula": "b",
                      "alias": "system"
                    },
                    {
                      "formula": "c",
                      "alias": "iowait"
                    },
                    {
                      "formula": "d",
                      "alias": "stolen"
                    }
                  ],
                  "display_type": "area"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "queue 컨테이너 CPU",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
