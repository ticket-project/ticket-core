        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "RDS ticket-core-db",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS CPU % (CloudWatch 1분 / Enhanced)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:aws.rds.cpuutilization{dbinstanceidentifier:ticket-core-db}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:aws.rds.cpuutilization.total{dbinstanceidentifier:ticket-core-db}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "CloudWatch CPU %"
                    },
                    {
                      "formula": "b",
                      "alias": "Enhanced CPU %"
                    }
                  ],
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 90",
                  "display_type": "error dashed",
                  "label": "90%"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS CPU 크레딧(t4g.micro)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:aws.rds.cpucredit_balance{dbinstanceidentifier:ticket-core-db}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:aws.rds.cpusurplus_credits_charged{dbinstanceidentifier:ticket-core-db}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "잔여 크레딧"
                    },
                    {
                      "formula": "b",
                      "alias": "초과 과금 크레딧"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS 연결 수",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:aws.rds.database_connections{dbinstanceidentifier:ticket-core-db}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "sum:postgresql.connections{$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "CloudWatch 연결"
                    },
                    {
                      "formula": "b",
                      "alias": "postgresql.connections"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS 읽기·쓰기 지연(초)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:aws.rds.read_latency{dbinstanceidentifier:ticket-core-db}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:aws.rds.write_latency{dbinstanceidentifier:ticket-core-db}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "read latency"
                    },
                    {
                      "formula": "b",
                      "alias": "write latency"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS IOPS",
              "show_legend": true,
              "legend_layout": "auto",
