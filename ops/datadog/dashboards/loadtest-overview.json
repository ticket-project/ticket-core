{
  "title": "[loadtest] 부하 테스트 한 화면",
  "description": "부하 테스트 중 위에서 아래로 훑는 한 화면: 호스트 → Core → nginx → Redis → RDS → queue → 부하 발생기. env·host 템플릿 변수로 좁힌다. trace.* 지표에는 host 태그가 없어 env로만 거른다.\n\nmanaged-by:ops-datadog",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [
        "prod",
        "local"
      ],
      "defaults": [
        "prod"
      ]
    },
    {
      "name": "host",
      "prefix": "host",
      "available_values": [],
      "defaults": [
        "*"
      ]
    }
  ],
  "notify_list": [],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "호스트·컨테이너",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "호스트 CPU % (host별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:system.cpu.user{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:system.cpu.system{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "avg:system.cpu.iowait{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "d",
                      "query": "avg:system.cpu.stolen{$env,$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "user"
                    },
                    {
                      "formula": "b",
                      "alias": "system"
                    },
                    {
                      "formula": "c",
                      "alias": "iowait"
                    },
                    {
                      "formula": "d",
                      "alias": "stolen"
                    }
                  ],
                  "display_type": "area"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "컨테이너 CPU (container_name별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:container.cpu.usage{$env,$host} by {container_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "CPU"
                    }
                  ],
                  "display_type": "area"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "호스트 네트워크 (host별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:system.net.bytes_rcvd{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "sum:system.net.bytes_sent{$env,$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "수신 B/s"
                    },
                    {
                      "formula": "b",
                      "alias": "송신 B/s"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "TCP listen 드롭",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:system.net.tcp.listen_overflows{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "sum:system.net.tcp.listen_drops{$env,$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "listen overflows"
                    },
                    {
                      "formula": "b",
                      "alias": "listen drops"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Core (ticket-be)",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "초당 요청 (status별, actuator 제외)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:ticket.http_server_requests_seconds.count{$env,$host,service:ticket-be,!uri:/actuator/*} by {status}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "req/s"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "초당 5xx",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:ticket.http_server_requests_seconds.count{$env,$host,service:ticket-be,!uri:/actuator/*,status:5*}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "5xx/s"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "최대 응답 시간 (uri별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:ticket.http_server_requests_seconds_max{$env,$host,service:ticket-be,!uri:/actuator/*} by {uri}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "max s"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "APM p95 응답 시간 (resource_name별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "p95:trace.servlet.request{$env,service:ticket-be} by {resource_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "p95"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Hikari 연결: active / pending / max",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:ticket.hikaricp_connections_active{$env,$host,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "max:ticket.hikaricp_connections_pending{$env,$host,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "avg:ticket.hikaricp_connections_max{$env,$host,service:ticket-be}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "active"
                    },
                    {
                      "formula": "b",
                      "alias": "pending"
                    },
                    {
                      "formula": "c",
                      "alias": "max"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Hikari 평균 점유·획득 시간(초)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:ticket.hikaricp_connections_usage_seconds.sum{$env,$host,service:ticket-be}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "sum:ticket.hikaricp_connections_usage_seconds.count{$env,$host,service:ticket-be}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "sum:ticket.hikaricp_connections_acquire_seconds.sum{$env,$host,service:ticket-be}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "d",
                      "query": "sum:ticket.hikaricp_connections_acquire_seconds.count{$env,$host,service:ticket-be}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a / b",
                      "alias": "평균 점유(usage)"
                    },
                    {
                      "formula": "c / d",
                      "alias": "평균 획득 대기(acquire)"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Tomcat 바쁜 스레드 / 최대",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:ticket.tomcat_threads_busy_threads{$env,$host,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:ticket.tomcat_threads_config_max_threads{$env,$host,service:ticket-be}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "busy"
                    },
                    {
                      "formula": "b",
                      "alias": "config max"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "JVM CPU: 프로세스 vs 시스템 (%)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:ticket.process_cpu_usage{$env,$host,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:ticket.system_cpu_usage{$env,$host,service:ticket-be}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 100",
                      "alias": "process %"
                    },
                    {
                      "formula": "b * 100",
                      "alias": "system %"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "GC 정지",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:ticket.jvm_gc_pause_seconds.sum{$env,$host,service:ticket-be}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "sum:ticket.jvm_gc_pause_seconds.count{$env,$host,service:ticket-be}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "max:ticket.jvm_gc_pause_seconds_max{$env,$host,service:ticket-be}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a / b",
                      "alias": "평균 정지(초)"
                    },
                    {
                      "formula": "c",
                      "alias": "최대 정지(초)"
                    },
                    {
                      "formula": "b",
                      "alias": "정지 횟수"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "DB·Redis 쿼리 시간 (APM 평균 / p95)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:trace.postgresql.query{$env,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "p95:trace.postgresql.query{$env,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "avg:trace.redis.query{$env,service:ticket-be}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "d",
                      "query": "p95:trace.redis.query{$env,service:ticket-be}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "postgresql avg"
                    },
                    {
                      "formula": "b",
                      "alias": "postgresql p95"
                    },
                    {
                      "formula": "c",
                      "alias": "redis avg"
                    },
                    {
                      "formula": "d",
                      "alias": "redis p95"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "nginx (Core 앞단)",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "nginx 초당 요청",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:nginx.net.request_per_s{$env,$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "req/s"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "nginx 연결 / 대기",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:nginx.net.connections{$env,$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "sum:nginx.net.waiting{$env,$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "connections"
                    },
                    {
                      "formula": "b",
                      "alias": "waiting"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Redis (Core)",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Redis 초당 명령",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
