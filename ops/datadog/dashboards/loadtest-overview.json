              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:redis.net.clients{$env,$host,!component:queue-redis}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "clients"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Redis 메모리",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:redis.mem.used{$env,$host,!component:queue-redis}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "used"
                    }
                  ],
                  "display_type": "line"
