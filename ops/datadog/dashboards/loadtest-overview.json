                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:redis.info.latency_ms{$env,$host,!component:queue-redis}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "latency ms"
