{
  "title": "[infra] 서버·비용",
  "description": "어떤 서버가 켜져 있는지, 무료 범위(호스트 10·APM 호스트 10·로그 월 500GB)를 넘는지 본다. 서버는 평소 꺼 두므로 빈 그래프 = 꺼짐. 로그 합계는 시간 범위를 이번 달로 놓고 본다.\n\nmanaged-by:ops-datadog",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [
        "prod",
        "local"
      ],
      "defaults": [
        "prod"
      ]
    },
    {
      "name": "host",
      "prefix": "host",
      "available_values": [],
      "defaults": [
        "*"
      ]
    }
  ],
  "notify_list": [],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "켜진 서버",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "켜진 호스트 (에이전트 보고)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:datadog.agent.running{*} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "running"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS 켜짐 (CPU 지표가 있으면 켜짐)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:aws.rds.cpuutilization{dbinstanceidentifier:ticket-core-db}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "CPU %"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RDS CPU 크레딧",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:aws.rds.cpucredit_balance{dbinstanceidentifier:ticket-core-db}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:aws.rds.cpusurplus_credit_balance{dbinstanceidentifier:ticket-core-db}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c",
                      "query": "avg:aws.rds.cpusurplus_credits_charged{dbinstanceidentifier:ticket-core-db}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "잔여 크레딧"
                    },
                    {
                      "formula": "b",
                      "alias": "빌린 크레딧"
                    },
                    {
                      "formula": "c",
                      "alias": "초과 과금 크레딧"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "디스크·메모리",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "디스크 사용률 (host·device별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:system.disk.in_use{*} by {host,device}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "in use ratio"
                    }
                  ],
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 0.8",
                  "display_type": "error dashed",
                  "label": "80%"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "컨테이너 메모리 (container_name별)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "avg:container.memory.working_set{*} by {host,container_name}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "working set"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "비용",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "AWS 예상 요금 (서비스별, USD)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:aws.billing.estimated_charges{*} by {servicename}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "USD"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Datadog 호스트 수",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:datadog.estimated_usage.hosts{*}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "max:datadog.estimated_usage.apm_hosts{*}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "hosts"
                    },
                    {
                      "formula": "b",
                      "alias": "APM hosts"
                    }
                  ],
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 10",
                  "display_type": "error dashed",
                  "label": "무료 10"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "로그 수집량 (선택 기간 합계)",
              "autoscale": true,
              "precision": 2,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:datadog.estimated_usage.logs.ingested_bytes{*}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "로그 수집 누적 (선택 기간)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:datadog.estimated_usage.logs.ingested_bytes{*}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "cumsum(a)",
                      "alias": "누적 bytes"
                    }
                  ],
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = 536870912000",
                  "display_type": "error dashed",
                  "label": "월 500GB"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "커스텀 지표 수",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "max:datadog.estimated_usage.metrics.custom{*}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "custom metrics"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
