{
  "name": "[core] 컨테이너 재시작 반복",
  "type": "metric alert",
  "query": "change(max(last_10m),last_10m):max:container.restarts{host:ticket-core-prod} by {container_name} > 2",
  "message": "{{container_name.name}} 컨테이너가 10분에 3번 이상 재시작했다. 먼저 볼 곳: 종료 코드, OOM, healthcheck, 배포 이벤트. (옛 호스트 이름 i-09739eeb559db0d1d. DD_HOSTNAME 적용 전이면 이 범위로 데이터가 안 들어온다)",
  "tags": [
    "service:ticket-be",
    "env:prod",
    "managed-by:ops-datadog"
  ],
  "priority": 2,
  "options": {
    "thresholds": {
      "critical": 2,
      "warning": 1
    },
    "notify_no_data": false,
    "require_full_window": false,
    "renotify_interval": 0,
    "include_tags": true,
    "notify_audit": false
  }
}
