{
  "name": "[db] RDS 연결 수 많음",
  "type": "metric alert",
  "query": "max(last_10m):max:aws.rds.database_connections{dbinstanceidentifier:ticket-core-db} > 70",
  "message": "ticket-core-db 연결 수가 많다(1GB 인스턴스 max_connections 약 80~100). Core 대당 Hikari 10 × 최대 4대 = 40이 정상 상한. 먼저 볼 곳: Core 대수·풀 크기, 남은 세션(pg_stat_activity), 부하 발생기 직접 연결.",
  "tags": [
    "service:ticket-core-db",
    "env:prod",
    "managed-by:ops-datadog"
  ],
  "priority": 2,
  "options": {
    "thresholds": {
      "critical": 70,
      "warning": 50
    },
    "notify_no_data": false,
    "require_full_window": false,
    "renotify_interval": 0,
    "include_tags": true,
    "notify_audit": false,
    "evaluation_delay": 900
  }
}
