{
  "name": "[core] 호스트 메모리 부족",
  "type": "metric alert",
  "query": "avg(last_10m):avg:system.mem.pct_usable{host:ticket-core-prod} < 0.15",
  "message": "Core 호스트 쓸 수 있는 메모리가 15% 아래다. 먼저 볼 곳: ticket-be·datadog-agent 메모리, OOM 기록. (옛 호스트 이름 i-09739eeb559db0d1d. DD_HOSTNAME 적용 전이면 이 범위로 데이터가 안 들어온다)",
  "tags": [
    "service:ticket-be",
    "env:prod",
    "managed-by:ops-datadog"
  ],
  "priority": 2,
  "options": {
    "thresholds": {
      "critical": 0.15,
      "warning": 0.25
    },
    "notify_no_data": false,
    "require_full_window": false,
    "renotify_interval": 0,
    "include_tags": true,
    "notify_audit": false
  }
}
